{
  "name": "starlight-mayor",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:rules": "node --experimental-strip-types tests/lightingRules.test.ts && node --experimental-strip-types tests/gameRules.test.ts && node --experimental-strip-types tests/gameStore.test.ts && node --experimental-strip-types tests/eventRules.test.ts && node --experimental-strip-types tests/audioThemes.test.ts",
    "check": "pnpm typecheck && pnpm test:rules && pnpm build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.5.0",
    "@react-three/postprocessing": "3.0.4",
    "@supabase/supabase-js": "2.103.1",
    "lucide-react": "0.576.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.181.2",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.4.23",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
